# 冥想一键工作流 · 环境变量清单
#
# 规则：**设了就用环境变量，没设就回落到 data/config.json**。
# 所以本机什么都不设也能照常跑；换机器 / CI / 服务器上，把这里填全就够了，
# config.json 里可以一个绝对路径、一个密钥都不留。
#
# 本机用法：把要设的写进 ~/.zshrc（export KEY="值"），开新终端生效。
# GitHub Actions：写进仓库 Settings → Secrets and variables → Actions。
# 密钥放 Secrets，路径放 Variables。
#
# ⚠️ 这个文件是模板，只放占位符，**永远不要往里填真实密钥**。
#    真实值放 ~/.zshrc 或 CI 的 Secrets 里。

# ── 密钥 ──────────────────────────────────────────────────────────────
# 文本引擎（选题 / 原稿 / 配音文本 / 发布文案）。也可存 macOS 钥匙串，
# 账户名 text-provider-api-key，服务名 com.shareit.sleepflow-studio。
TEXT_API_KEY=

# MiniMax 语音合成。订阅制用 SUBSCRIPTION，按量用 API，看 config.minimax.deliveryMode。
MINIMAX_API_KEY=
MINIMAX_SUBSCRIPTION_KEY=

# SenseNova：封面图的构图设计与出图。没有它封面这一步会直接报错。
SENSENOVA_API_KEY=

# Agnes 视觉流水线。逗号或换行分隔，可以填多个轮转用。
#   apiKeys  主池：提示词 / 生图 / 生视频
#   videoKeys 留空则从主池尾部按 AGNES_RESERVED_FOR_VIDEO 切出来
AGNES_API_KEYS=
AGNES_VIDEO_KEYS=
AGNES_SCORER_KEYS=
AGNES_MOTION_KEYS=

# ── 路径 ──────────────────────────────────────────────────────────────
# 成品落地目录（音频 / 视频 / 文本 / 清单 / 封面）
MEDITATION_OUTPUT_ROOT=/path/to/output

# Skill 文件所在目录，多个用逗号或换行分隔
MEDITATION_SKILL_ROOTS=/path/to/skills-a,/path/to/skills-b

# 背景音乐库、垫底视频素材库
MEDITATION_BGM_ROOT=/path/to/bgm
MEDITATION_VIDEO_ROOT=/path/to/video

# B 站封面的固定取用目录（4比3.png / 16比9.png 落在这里）
MEDITATION_COVER_DIR=/path/to/bilibili

# agnes-playground 项目根目录（只有走浏览器版视觉时才需要）
AGNES_PROJECT_ROOT=/path/to/agnes-playground

# ── Agnes 视觉 ────────────────────────────────────────────────────────
# 开关：true 走服务内直调 API（不需要开浏览器页面），false 退回浏览器版
AGNES_HEADLESS_ENABLED=true

# 端点。注意 apihub 和 api 是两套令牌 + 两套模型名，不能混用。
AGNES_BASE_URL=https://api.agnes-ai.cn
AGNES_SCORER_URL=https://token.sensenova.cn/v1
AGNES_MOTION_URL=https://token.sensenova.cn/v1

# 模型。官方 API 上目前只有这几个可用。
AGNES_TEXT_MODEL=agnes-2.5-flash
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_VIDEO_MODEL=agnes-video-v2.0

# 候选图张数；从主池尾部留给生视频的 key 个数（生图永远不碰这几个）
AGNES_CANDIDATE_COUNT=6
AGNES_RESERVED_FOR_VIDEO=1

# 片头叠加的半透明封面图；两段视觉成品的落地目录
AGNES_COVER_PATH=/path/to/cover.png
AGNES_OUTPUT_DIR=/path/to/agnes-output
