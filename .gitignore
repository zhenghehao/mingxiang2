node_modules/
data/config.json
data/asset-history.json
# 真实密钥只放这里，.env.example 才是提交进仓库的模板
.env
.env.*
!.env.example
work/runs/
# 成品目录是 output（单数，见 config.app.outputRoot）。原来只写了 outputs（复数），
# 名字对不上＝形同虚设：跑几条就有上百 MB 的 mp3 和成片等着被提交进来。
# playwright 那张调试截图是仓库里本来就有的，单独放行。
output/*
!output/playwright/
outputs/*
!outputs/.gitkeep
.DS_Store
.playwright-cli/
迁移包-*/
迁移包-*.zip
迁移包-*.sha256

# 内嵌 Python 运行时：4900+ 个文件，是 uv 装出来的，克隆后重装即可
# 重装：cd extensions/draft-publisher/app && uv sync --extra web
extensions/draft-publisher/runtime/
extensions/draft-publisher/**/.venv*/
extensions/draft-publisher/**/__pycache__/
extensions/draft-publisher/**/.uv-cache/
# uv sync 会就地 build 这个包，产出的元数据目录没必要进仓库
extensions/draft-publisher/**/*.egg-info/
# Python 字节码，任何目录都不进仓库（跑一次脚本就会生成）
__pycache__/
*.py[cod]
# 平台登录 cookie —— 绝对不能进仓库
extensions/draft-publisher/app/cookiesFile/
extensions/draft-publisher/app/.publisher_data/
# 跑过的任务记录，只对当时那台机器有意义
work/draft-jobs/
# draftQueue 是同一类东西：跑过的平台任务记录，含真实标题和本机绝对路径
extensions/draft-publisher/app/draftQueue/
# 账号库本体：只存 cookie 文件名和账号名，但账号名会把仓库关联到真实频道。
# 只挡 .db，不挡整个 db/ —— createTable.py 是建表脚本，新机器要靠它重建库。
extensions/draft-publisher/app/db/*.db

# Vercel 控制台：真实账号口令和 token 只放本机这个文件，永不进仓库
web-console/.env.local
web-console/.vercel/

# Claude Code 的本机权限白名单，只对这台机器有意义
.claude/settings.local.json
